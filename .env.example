# Copy this file to .env and fill in real values for local development.
# Production deployments should set these via the platform's secret manager
# (docker -e ..., systemd unit, etc.) rather than committing a .env file.
#
# `loadConfig()` in app/config.ts is the single reader and will fail-fast at
# startup listing every missing var when MARKY_AUTH=discord.

# -- Common --------------------------------------------------------------

# Listen port. Default: 44100.
PORT=44100

# Path to the markdown content directory. Created on first run.
# Default: ./content (a gitignored directory in the project root).
# MARKY_CONTENT_DIR=/path/to/notes

# Auth mode. Either "anonymous" (default) or "discord".
# anonymous: no login; browser generates {name, color} and stores in localStorage
# discord:   OAuth gate, only members of DISCORD_GUILD_ID can edit
MARKY_AUTH=anonymous

# -- Discord (required when MARKY_AUTH=discord) --------------------------

# OAuth credentials from https://discord.com/developers/applications.
# Redirect URI to configure in the developer portal:
#   <MARKY_BASE_URL>/auth/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Snowflake of the guild users must be a member of. Enable Developer Mode
# in Discord (Settings -> Advanced) then right-click the server -> Copy Server ID.
# DISCORD_GUILD_ID=

# External origin where marky is reachable. Used to build the OAuth
# redirect URI and to decide whether the session cookie gets `Secure`.
# Examples:
#   http://localhost:44100      (local dev; cookie is non-Secure)
#   https://marky.example.com   (production; cookie is Secure)
# Trailing slashes are ignored.
# MARKY_BASE_URL=

# Secret used to sign the session cookie. Use a long random string, e.g.
#   openssl rand -hex 32
# Rotating the secret invalidates all existing sessions.
# SESSION_SECRET=

# -- Discord (optional) --------------------------------------------------

# Bot token from the same Discord application. When set, marky calls
# GET /guilds/{id}/roles (bot-only endpoint) and colors users by their
# highest-positioned colored Discord role. Without this, every signed-in
# user gets a stable palette color hashed from their Discord user id.
# The bot does not need any special permissions beyond default; invite it
# into your guild and copy its token here.
# DISCORD_BOT_TOKEN=
