# Listen port. Default: 44100.
PORT=44100

# Markdown directory. Default: ./content
# MARKY_CONTENT_DIR=

# "anonymous" (default) or "discord"
MARKY_AUTH=anonymous

# Required when MARKY_AUTH=discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_GUILD_ID=
# MARKY_BASE_URL=https://marky.example.com
# SESSION_SECRET=

# Optional. Enables true Discord role color.
# DISCORD_BOT_TOKEN=
