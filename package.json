{
  "name": "marky",
  "version": "0.1.0",
  "description": "simple realtime markdown editor",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server.ts",
    "dev:browser": "esbuild app/assets/entry.tsx --outbase=app/assets --outdir=public/assets --bundle --splitting --format=esm --entry-names='[dir]/[name]' --chunk-names='chunks/[name]-[hash]' --sourcemap --watch",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remix-run/dom": "jam",
    "@remix-run/fetch-router": "^0.8.0",
    "@remix-run/headers": "^0.16.0",
    "@remix-run/interaction": "^0.1.0",
    "@remix-run/lazy-file": "^3.7.0",
    "@remix-run/node-fetch-server": "^0.12.0",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.3",
    "ws": "^8.18.3",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6"
  },
  "keywords": [],
  "author": "Jack Arthur Harrhy (me@jackharrhy.com)",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
